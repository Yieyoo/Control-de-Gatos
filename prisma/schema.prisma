// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Categorías
model Categoria {
  id                  Int      @id @default(autoincrement())
  nombre              String   @unique
  color               String   @default("#3b82f6")
  icono               String?
  esDelSistema        Boolean  @default(false)
  tipoPresupuesto     String?  // "necesidad" o "gusto" -- para el reparto de "% destinado a"
  fechaCreacion       DateTime @default(now())

  // Relaciones
  gastosFijos         GastoFijo[]
  gastosVariables     GastoVariable[]
  gatosDomiciliados   GastoDomiciliado[]
  comprasTarjeta      CompraTarjeta[]

  @@map("categorias")
}

// Ingresos
model Ingreso {
  id                  Int      @id @default(autoincrement())
  nombre              String
  cantidad            Float
  frecuencia          String   // "mensual", "quincenal", "unico"
  fechaInicio         DateTime @default(now())
  ultimaOcurrenciaMaterializada DateTime? // Hasta qué fecha ya se acreditó al saldo disponible
  activo              Boolean  @default(true)
  notas               String?
  fechaCreacion       DateTime @default(now())
  fechaActualizacion  DateTime @updatedAt

  @@map("ingresos")
}

// Lugares de Ahorro
model AhorroLugar {
  id                  Int      @id @default(autoincrement())
  nombre              String   @unique
  tipo                String   // "cuenta_ahorro", "inversion", "efectivo", "otra"
  saldoActual         Float    @default(0)
  notas               String?
  fechaCreacion       DateTime @default(now())
  fechaActualizacion  DateTime @updatedAt

  // Relaciones
  movimientos         MovimientoAhorro[]
  ahorrosDomiciliados AhorroDomiciliado[]
  transferenciasOrigen MovimientoAhorro[] @relation("transferenciasOrigen")
  gastosVariables     GastoVariable[]
  pagosTarjeta        PagoTarjeta[]

  @@map("ahorro_lugares")
}

// Movimientos de Ahorro (depósitos, retiros, transferencias)
model MovimientoAhorro {
  id                  Int      @id @default(autoincrement())
  ahorroId            Int
  ahorro              AhorroLugar @relation(fields: [ahorroId], references: [id], onDelete: Cascade)
  tipo                String   // "deposito", "retiro", "transferencia"
  cantidad            Float
  fecha               DateTime @default(now())
  concepto            String
  ahorroOrigenId      Int?     // Para transferencias
  ahorroOrigen        AhorroLugar? @relation("transferenciasOrigen", fields: [ahorroOrigenId], references: [id], onDelete: SetNull)

  // "manual" (afecta dinero disponible: transferencia manual disponible<->ahorro),
  // "domiciliado" (confirmado a mano con el checkbox "ya lo envié" de un
  // AhorroDomiciliado -- ver confirmarAhorroDomiciliado en src/lib/finanzas.ts;
  // también afecta dinero disponible), "pago_gasto" / "pago_tarjeta" (retiro
  // directo para pagar algo con fuente="ahorro", no toca disponible)
  origen              String   @default("manual")
  ahorroDomiciliadoOrigenId Int?
  ahorroDomiciliadoOrigen   AhorroDomiciliado? @relation("materializadoDeAhorroDomiciliado", fields: [ahorroDomiciliadoOrigenId], references: [id], onDelete: SetNull)

  // Retiro generado automáticamente al pagar algo con fuente="ahorro" (relación inversa, ver GastoVariable/PagoTarjeta)
  gastoVariable       GastoVariable? @relation("retiroDeGasto")
  pagoTarjeta         PagoTarjeta?   @relation("retiroDePago")

  // Evita confirmar dos veces la misma ocurrencia de un ahorro domiciliado
  // (ej. doble clic en el checkbox) -- NULLs no chocan entre sí en Postgres,
  // así que no afecta a movimientos de otros orígenes.
  @@unique([ahorroDomiciliadoOrigenId, fecha])
  @@map("movimientos_ahorro")
}

// Gastos Fijos (domiciliados)
model GastoDomiciliado {
  id                  Int      @id @default(autoincrement())
  nombre              String
  cantidad            Float
  fechaCobro          Int?     // Día del mes (1-31); no aplica si frecuencia = "semanal"
  frecuencia          String   // "mensual", "quincenal", "semanal"
  diasSemana          String?  // solo si frecuencia = "semanal": ej "1,2,3,4,5" (0=domingo..6=sábado)
  categoriaId         Int
  categoria           Categoria @relation(fields: [categoriaId], references: [id])
  cuentaPago          String
  tarjetaId           Int?     // Si este gasto se carga a una tarjeta de crédito
  tarjeta             TarjetaCredito? @relation(fields: [tarjetaId], references: [id], onDelete: SetNull)
  pagadoAdelantadoHasta DateTime? // Solo aplica si tarjetaId != null: hasta qué fecha de cobro ya marcaste "ya pagué este cargo" (no cuenta como deuda de tarjeta ni como pendiente de disponible)
  ultimaOcurrenciaMaterializada DateTime? // Ya no se usa (si tarjetaId == null, cada ocurrencia se confirma a mano y se detecta por la fila real en GastoVariable, no por este marcador); se conserva por compatibilidad con datos existentes.
  tipoPresupuesto     String?  // "necesidad" o "gusto"; si es null, hereda el de la categoría
  activo              Boolean  @default(true)
  notas               String?
  fechaCreacion       DateTime @default(now())
  fechaActualizacion  DateTime @updatedAt

  // Relaciones
  gastosGenerados     GastoVariable[] @relation("materializadoDeGastoDomiciliado")

  @@map("gastos_domiciliados")
}

// Ahorros Domiciliados (transferencias automáticas a ahorro)
model AhorroDomiciliado {
  id                  Int      @id @default(autoincrement())
  nombre              String
  cantidad            Float
  frecuencia          String   // "mensual", "quincenal", "semanal"
  diasSemana          String?  // solo si frecuencia = "semanal": ej "2" (0=domingo..6=sábado)
  ahorroDestinoId     Int
  ahorroDestino       AhorroLugar @relation(fields: [ahorroDestinoId], references: [id])
  fechaInicio         DateTime @default(now())
  ultimaOcurrenciaMaterializada DateTime? // Ya no se usa para generar movimientos automáticamente (ver enviadoHasta); se conserva por compatibilidad con datos existentes.
  enviadoHasta        DateTime? // Hasta qué fecha de ocurrencia ya marcaste "ya lo envié" -- crea el MovimientoAhorro real y descuenta dinero disponible.
  activo              Boolean  @default(true)
  notas               String?
  fechaCreacion       DateTime @default(now())
  fechaActualizacion  DateTime @updatedAt

  // Relaciones
  movimientosGenerados MovimientoAhorro[] @relation("materializadoDeAhorroDomiciliado")

  @@map("ahorros_domiciliados")
}

// Gastos Fijos Manuales
model GastoFijo {
  id                  Int      @id @default(autoincrement())
  nombre              String
  cantidad            Float
  categoriaId         Int
  categoria           Categoria @relation(fields: [categoriaId], references: [id])
  fechaPago           Int      // Día del mes (1-31)
  activo              Boolean  @default(true)
  notas               String?
  fechaCreacion       DateTime @default(now())
  fechaActualizacion  DateTime @updatedAt

  @@map("gastos_fijos")
}

// Gastos Variables
model GastoVariable {
  id                  Int      @id @default(autoincrement())
  nombre              String
  cantidad            Float
  categoriaId         Int
  categoria           Categoria @relation(fields: [categoriaId], references: [id])
  fecha               DateTime @default(now())
  notas               String?
  tipoPresupuesto     String?  // "necesidad" o "gusto"; si es null, hereda el de la categoría
  fechaCreacion       DateTime @default(now())

  // De dónde salió el dinero: "disponible" (default, resta dinero disponible),
  // "ahorro" (sale de una cuenta de ahorro, ver movimientoAhorroId/ahorroLugarId,
  // NO resta disponible pero sí cuenta en tus estadísticas de gasto), o
  // "tercero" (dinero que alguien más te depositó, ver depositoTerceroId,
  // NO resta disponible NI cuenta en tus estadísticas de gasto personal)
  fuente              String   @default("disponible")

  ahorroLugarId       Int?
  ahorroLugar         AhorroLugar? @relation(fields: [ahorroLugarId], references: [id], onDelete: SetNull)
  movimientoAhorroId  Int?     @unique // retiro creado automáticamente cuando fuente="ahorro"
  movimientoAhorro    MovimientoAhorro? @relation("retiroDeGasto", fields: [movimientoAhorroId], references: [id], onDelete: SetNull)

  depositoTerceroId   Int?
  depositoTercero     DepositoTercero? @relation(fields: [depositoTerceroId], references: [id], onDelete: SetNull)

  // Si este gasto se generó al confirmar ("ya se cobró") una ocurrencia de un
  // gasto domiciliado en efectivo
  gastoDomiciliadoOrigenId Int?
  gastoDomiciliadoOrigen   GastoDomiciliado? @relation("materializadoDeGastoDomiciliado", fields: [gastoDomiciliadoOrigenId], references: [id], onDelete: SetNull)

  devoluciones        Devolucion[]

  // Evita confirmar dos veces la misma ocurrencia de un gasto domiciliado
  // (ej. doble clic en el checkbox) -- NULLs no chocan entre sí en Postgres,
  // así que no afecta a gastos variables manuales.
  @@unique([gastoDomiciliadoOrigenId, fecha])
  @@map("gastos_variables")
}

// Tarjetas de Crédito
model TarjetaCredito {
  id                  Int      @id @default(autoincrement())
  nombre              String
  diaCorte            Int      // Día del mes en que corta el estado de cuenta (1-31)
  pagoQuincenal       Float?   // Cuánto planeas pagar cada quincena a esta tarjeta
  activa              Boolean  @default(true)
  notas               String?
  fechaCreacion       DateTime @default(now())
  fechaActualizacion  DateTime @updatedAt

  // Relaciones
  compras             CompraTarjeta[]
  pagos               PagoTarjeta[]
  gastosDomiciliados  GastoDomiciliado[]

  @@map("tarjetas_credito")
}

// Compras hechas con tarjeta de crédito
model CompraTarjeta {
  id                  Int      @id @default(autoincrement())
  nombre              String
  cantidad            Float
  fecha               DateTime @default(now())
  tarjetaId           Int
  tarjeta             TarjetaCredito @relation(fields: [tarjetaId], references: [id], onDelete: Cascade)
  categoriaId         Int?
  categoria           Categoria? @relation(fields: [categoriaId], references: [id])
  notas               String?
  tipoPresupuesto     String?  // "necesidad" o "gusto"; si es null, hereda el de la categoría
  fechaCreacion       DateTime @default(now())

  // Meses sin intereses: null = de contado. Si tiene valor, la compra completa
  // ya cuenta como deuda de inmediato (igual que de contado); estos campos son
  // solo para mostrar "$X/mes, N meses" -- el pago real sigue siendo PagoTarjeta.
  numeroMeses         Int?
  montoMensual        Float?

  pagos               PagoTarjeta[] // pagos atribuidos opcionalmente a esta compra (para ver cuotas MSI pagadas)
  devoluciones        Devolucion[]

  @@map("compras_tarjeta")
}

// Pagos hechos a la tarjeta de crédito (abonos a la deuda)
model PagoTarjeta {
  id                  Int      @id @default(autoincrement())
  cantidad            Float
  fecha               DateTime @default(now())
  concepto            String?
  tarjetaId           Int
  tarjeta             TarjetaCredito @relation(fields: [tarjetaId], references: [id], onDelete: Cascade)
  fechaCreacion       DateTime @default(now())

  // De dónde salió el dinero para pagar la tarjeta (mismo significado que en GastoVariable.fuente)
  fuente              String   @default("disponible")

  ahorroLugarId       Int?
  ahorroLugar         AhorroLugar? @relation(fields: [ahorroLugarId], references: [id], onDelete: SetNull)
  movimientoAhorroId  Int?     @unique
  movimientoAhorro    MovimientoAhorro? @relation("retiroDePago", fields: [movimientoAhorroId], references: [id], onDelete: SetNull)

  depositoTerceroId   Int?
  depositoTercero     DepositoTercero? @relation(fields: [depositoTerceroId], references: [id], onDelete: SetNull)

  // Atribución opcional: a qué compra específica corresponde este pago (útil para MSI)
  compraTarjetaId     Int?
  compraTarjeta       CompraTarjeta? @relation(fields: [compraTarjetaId], references: [id], onDelete: SetNull)

  @@map("pagos_tarjeta")
}

// Dinero que alguien más te depositó para que pagaras algo específico (no es tuyo)
model DepositoTercero {
  id                  Int      @id @default(autoincrement())
  persona             String
  cantidad            Float
  concepto            String
  fecha               DateTime @default(now())
  pagoRelacionado     String?  // descripción libre de a qué pago corresponde
  notas               String?
  fechaCreacion       DateTime @default(now())
  fechaActualizacion  DateTime @updatedAt

  // Lo "utilizado"/"pendiente"/"estado" se calculan al leer sumando estas relaciones,
  // igual que ya se hace hoy con la deuda de tarjeta (no se guardan como columnas).
  gastosVariables     GastoVariable[]
  pagosTarjeta        PagoTarjeta[]

  @@map("depositos_terceros")
}

// Devolución (parcial o total) de un gasto o compra de tarjeta ya registrados
model Devolucion {
  id                  Int      @id @default(autoincrement())
  cantidad            Float
  fecha               DateTime @default(now())
  concepto            String?
  fechaCreacion       DateTime @default(now())

  gastoVariableId     Int?
  gastoVariable       GastoVariable? @relation(fields: [gastoVariableId], references: [id], onDelete: Cascade)

  compraTarjetaId     Int?
  compraTarjeta       CompraTarjeta? @relation(fields: [compraTarjetaId], references: [id], onDelete: Cascade)

  @@map("devoluciones")
}

// Configuración
model Configuracion {
  clave               String   @id
  valor               String
  fechaActualizacion  DateTime @updatedAt

  @@map("configuraciones")
}
