// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Categorías
model Categoria {
  id                  Int      @id @default(autoincrement())
  nombre              String   @unique
  color               String   @default("#3b82f6")
  icono               String?
  esDelSistema        Boolean  @default(false)
  tipoPresupuesto     String?  // "necesidad" o "gusto" -- para el reparto de "% destinado a"
  fechaCreacion       DateTime @default(now())

  // Relaciones
  gastosFijos         GastoFijo[]
  gastosVariables     GastoVariable[]
  gatosDomiciliados   GastoDomiciliado[]
  comprasTarjeta      CompraTarjeta[]

  @@map("categorias")
}

// Ingresos
model Ingreso {
  id                  Int      @id @default(autoincrement())
  nombre              String
  cantidad            Float
  frecuencia          String   // "mensual", "quincenal", "unico"
  fechaInicio         DateTime @default(now())
  activo              Boolean  @default(true)
  notas               String?
  fechaCreacion       DateTime @default(now())
  fechaActualizacion  DateTime @updatedAt

  @@map("ingresos")
}

// Lugares de Ahorro
model AhorroLugar {
  id                  Int      @id @default(autoincrement())
  nombre              String   @unique
  tipo                String   // "cuenta_ahorro", "inversion", "efectivo", "otra"
  saldoActual         Float    @default(0)
  notas               String?
  fechaCreacion       DateTime @default(now())
  fechaActualizacion  DateTime @updatedAt

  // Relaciones
  movimientos         MovimientoAhorro[]
  ahorrosDomiciliados AhorroDomiciliado[]
  transferenciasOrigen MovimientoAhorro[] @relation("transferenciasOrigen")

  @@map("ahorro_lugares")
}

// Movimientos de Ahorro (depósitos, retiros, transferencias)
model MovimientoAhorro {
  id                  Int      @id @default(autoincrement())
  ahorroId            Int
  ahorro              AhorroLugar @relation(fields: [ahorroId], references: [id], onDelete: Cascade)
  tipo                String   // "deposito", "retiro", "transferencia"
  cantidad            Float
  fecha               DateTime @default(now())
  concepto            String
  ahorroOrigenId      Int?     // Para transferencias
  ahorroOrigen        AhorroLugar? @relation("transferenciasOrigen", fields: [ahorroOrigenId], references: [id], onDelete: SetNull)

  // Relación con transacción general
  transacciones       Transaccion[]

  @@map("movimientos_ahorro")
}

// Gastos Fijos (domiciliados)
model GastoDomiciliado {
  id                  Int      @id @default(autoincrement())
  nombre              String
  cantidad            Float
  fechaCobro          Int?     // Día del mes (1-31); no aplica si frecuencia = "semanal"
  frecuencia          String   // "mensual", "quincenal", "semanal"
  diasSemana          String?  // solo si frecuencia = "semanal": ej "1,2,3,4,5" (0=domingo..6=sábado)
  categoriaId         Int
  categoria           Categoria @relation(fields: [categoriaId], references: [id])
  cuentaPago          String
  tarjetaId           Int?     // Si este gasto se carga a una tarjeta de crédito
  tarjeta             TarjetaCredito? @relation(fields: [tarjetaId], references: [id], onDelete: SetNull)
  pagadoAdelantadoHasta DateTime? // Marca hasta qué fecha de cobro ya se pagó por adelantado (no cuenta como deuda de tarjeta)
  tipoPresupuesto     String?  // "necesidad" o "gusto"; si es null, hereda el de la categoría
  activo              Boolean  @default(true)
  notas               String?
  fechaCreacion       DateTime @default(now())
  fechaActualizacion  DateTime @updatedAt

  // Relaciones
  transacciones       Transaccion[]

  @@map("gastos_domiciliados")
}

// Ahorros Domiciliados (transferencias automáticas a ahorro)
model AhorroDomiciliado {
  id                  Int      @id @default(autoincrement())
  nombre              String
  cantidad            Float
  frecuencia          String   // "mensual", "quincenal", "semanal"
  diasSemana          String?  // solo si frecuencia = "semanal": ej "2" (0=domingo..6=sábado)
  ahorroDestinoId     Int
  ahorroDestino       AhorroLugar @relation(fields: [ahorroDestinoId], references: [id])
  fechaInicio         DateTime @default(now())
  activo              Boolean  @default(true)
  notas               String?
  fechaCreacion       DateTime @default(now())
  fechaActualizacion  DateTime @updatedAt

  // Relaciones
  transacciones       Transaccion[]

  @@map("ahorros_domiciliados")
}

// Gastos Fijos Manuales
model GastoFijo {
  id                  Int      @id @default(autoincrement())
  nombre              String
  cantidad            Float
  categoriaId         Int
  categoria           Categoria @relation(fields: [categoriaId], references: [id])
  fechaPago           Int      // Día del mes (1-31)
  activo              Boolean  @default(true)
  notas               String?
  fechaCreacion       DateTime @default(now())
  fechaActualizacion  DateTime @updatedAt

  @@map("gastos_fijos")
}

// Gastos Variables
model GastoVariable {
  id                  Int      @id @default(autoincrement())
  nombre              String
  cantidad            Float
  categoriaId         Int
  categoria           Categoria @relation(fields: [categoriaId], references: [id])
  fecha               DateTime @default(now())
  notas               String?
  tipoPresupuesto     String?  // "necesidad" o "gusto"; si es null, hereda el de la categoría
  fechaCreacion       DateTime @default(now())

  // Relación con transacción general
  transacciones       Transaccion[]

  @@map("gastos_variables")
}

// Tarjetas de Crédito
model TarjetaCredito {
  id                  Int      @id @default(autoincrement())
  nombre              String
  diaCorte            Int      // Día del mes en que corta el estado de cuenta (1-31)
  pagoQuincenal       Float?   // Cuánto planeas pagar cada quincena a esta tarjeta
  activa              Boolean  @default(true)
  notas               String?
  fechaCreacion       DateTime @default(now())
  fechaActualizacion  DateTime @updatedAt

  // Relaciones
  compras             CompraTarjeta[]
  pagos               PagoTarjeta[]
  gastosDomiciliados  GastoDomiciliado[]

  @@map("tarjetas_credito")
}

// Compras hechas con tarjeta de crédito
model CompraTarjeta {
  id                  Int      @id @default(autoincrement())
  nombre              String
  cantidad            Float
  fecha               DateTime @default(now())
  tarjetaId           Int
  tarjeta             TarjetaCredito @relation(fields: [tarjetaId], references: [id], onDelete: Cascade)
  categoriaId         Int?
  categoria           Categoria? @relation(fields: [categoriaId], references: [id])
  notas               String?
  fechaCreacion       DateTime @default(now())

  @@map("compras_tarjeta")
}

// Pagos hechos a la tarjeta de crédito (abonos a la deuda)
model PagoTarjeta {
  id                  Int      @id @default(autoincrement())
  cantidad            Float
  fecha               DateTime @default(now())
  concepto            String?
  tarjetaId           Int
  tarjeta             TarjetaCredito @relation(fields: [tarjetaId], references: [id], onDelete: Cascade)
  fechaCreacion       DateTime @default(now())

  @@map("pagos_tarjeta")
}

// Historial unificado de transacciones
model Transaccion {
  id                  Int      @id @default(autoincrement())
  tipo                String   // "ingreso", "gasto_fijo", "gasto_variable", "ahorro", "transferencia"
  subtipo             String?
  cantidad            Float
  fecha               DateTime @default(now())
  concepto            String
  categoriaId         Int?
  cuenta              String?
  estado              String   @default("completado") // "completado", "programado", "pendiente"
  
  // Relaciones
  gastoDomiciliadoId  Int?
  gastoDomiciliado    GastoDomiciliado? @relation(fields: [gastoDomiciliadoId], references: [id], onDelete: SetNull)
  
  ahorroDomiciliadoId Int?
  ahorroDomiciliado   AhorroDomiciliado? @relation(fields: [ahorroDomiciliadoId], references: [id], onDelete: SetNull)
  
  movimientoAhorroId  Int?
  movimientoAhorro    MovimientoAhorro? @relation(fields: [movimientoAhorroId], references: [id], onDelete: SetNull)
  
  gastoVariableId     Int?
  gastoVariable       GastoVariable? @relation(fields: [gastoVariableId], references: [id], onDelete: SetNull)

  @@map("transacciones")
}

// Configuración
model Configuracion {
  clave               String   @id
  valor               String
  fechaActualizacion  DateTime @updatedAt

  @@map("configuraciones")
}
